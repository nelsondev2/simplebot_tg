{
  "name": "Deltachat Telegram Bridge",
  "description": "Deltachat bot (deltabot-cli) to comunicate with Telegram users",
  "keywords": [
    "deltabot",
    "deltabot-cli",
    "deltachat",
    "telegram",
    "bridge"
  ],
  "success_url": "https://delta.chat",
  "website": "https://github.com/Nenirey/simplebot_tg",
  "repository": "https://github.com/Nenirey/simplebot_tg",
  "env": {
    "ADMIN": {
      "description": "Your own email as bot administrator",
      "value": ""
    },
    "ADDR": {
      "description": "The email bot with imap enabled",
      "value": ""
    },
    "PASSWORD": {
      "description": "The email bot password",
      "value": ""
    },
    "TGTOKEN": {
      "description": "(Optional) Telegram session token, used to store a backup of the bot db in Telegram",
      "required": false,
      "value": ""
    },
    "CONFIG_DIR": {
      "description": "(Optional) Folder where the bot account is stored, default: $HOME/.simplebot",
      "required": false,
      "value": ""
    },
    "WHITE_LIST": {
      "description": "(Optional) space separated list of emails allowed to use the bot",
      "required": false,
      "value": ""
    },
    "BLACK_LIST": {
      "description": "(Optional) space separated list of emails blocked from using the bot",
      "required": false,
      "value": ""
    },
    "API_ID": {
      "description": "Get this value from https://my.telegram.org",
      "value": ""
    },
    "API_HASH": {
      "description": "Get this value from https://my.telegram.org",
      "value": ""
    },
    "DBXTOKEN": {
      "description": "Get this value from https://www.dropbox.com/developers/apps/create",
      "required": false,
      "value": ""
    },
    "APP_KEY": {
      "description": "Get this value from https://www.dropbox.com/developers/apps/create",
      "required": false,
      "value": ""
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql",
      "options": {
        "version": "14"
      }
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "bot": {
      "quantity": 1,
      "size": "free"
    }
  }
}
